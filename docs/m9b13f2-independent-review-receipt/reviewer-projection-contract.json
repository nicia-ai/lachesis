    "algorithm",
    "unsignedProjectionProtocol",
    "canonicalizationProtocol",
    "signingInputSha256",
    "signatureBase64"
  ],
  "signingBytesDefinition": "UTF8(RFC8785(reviewerUnsignedProjection))",
  "signingInputDigestDefinition": "SHA-256(UTF8(RFC8785(reviewerUnsignedProjection)))",
  "signatureAlgorithm": "Ed25519"
}
