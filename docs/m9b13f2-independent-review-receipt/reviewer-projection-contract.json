  "canonicalizationProtocol": "lachesis-m9b13f2-rfc8785-json-canonicalization/1",
  "unsignedProjectionSchema": {
    "topLevelFieldsExactly": [
      "protocol",
      "receiptProtocol",
      "reviewedSupplement",
      "authorEvidence",
      "reviewerEvidence",
      "reviewEvidenceInventory",
      "decision",
      "authorityBoundary"
    ],
    "nestedFieldsExactly": {
