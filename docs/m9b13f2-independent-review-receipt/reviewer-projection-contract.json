        "supplementBodyProtocol",
        "supplementBodyCanonicalSha256",
        "bodyPayloadProtocol",
        "bodyPayloadRawSha256",
        "packageInventoryProtocol",
        "packageInventoryCanonicalSha256",
        "completePackageManifestProtocol",
        "completePackageManifestRawSha256",
        "finalGitCommit",
        "finalGitTree"
      ],
      "/authorEvidence": [
        "publicKeyEvidenceProtocol",
        "publicKeyIdentity",
        "publicKeyCommitment",
        "spkiDerSha256",
        "attestationProtocol",
        "attestationRawSha256",
        "attestationCanonicalSha256",
        "unsignedProjectionProtocol",
        "signingInputSha256",
        "signatureBase64"
      ],
      "/reviewerEvidence": [
        "publicKeyEvidenceProtocol",
        "publicKeyIdentity",
        "publicKeyCommitment",
        "spkiDerSha256"
      ],
      "/reviewEvidenceInventory": [
        "protocol",
        "canonicalSha256",
        "artifactCount",
        "artifacts"
      ],
