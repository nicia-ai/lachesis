      "sha256": "8e6f89521a0694e445f42decd022f48369c634f1b5bcb5975135b69c88629ae8"
    }
  ],
  "algorithm": [
    "request-only-the-bound-commit-object",
    "reconstruct-and-hash-the-commit-object",
    "extract-the-root-tree-id-from-the-verified-commit",
    "request-only-the-next-tree-object-discovered-from-the-verified-parent",
    "reconstruct-and-hash-every-tree",
    "traverse-only-the-bound-unambiguous-path",
    "require-tree-mode-40000-for-intermediate-components",
    "require-regular-blob-mode-100644-for-the-final-component",
    "reconstruct-and-hash-the-final-blob",
    "require-both-git-blob-id-and-sha256"
  ],
  "reject": [
    "repository-commit-tree-path-blob-or-mode-substitution",
    "symlink",
    "submodule",
    "duplicate-or-ambiguous-entry",
    "malformed-or-alternate-encoding",
    "unrequested-traversal"
  ]
}
