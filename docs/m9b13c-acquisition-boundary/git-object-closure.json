      "blob": "611d1d2858eff2204e357de60a188b88ef1cd1c7",
      "sha256": "4e06e614086ad016d795d1005e821c595cf4e7c8e18bf03aecacc74191dd5e68"
    },
    {
      "repository": "nodejs/release-keys",
      "commit": "b28073028e6d6855cfb53bf7fa0137599c01f967",
