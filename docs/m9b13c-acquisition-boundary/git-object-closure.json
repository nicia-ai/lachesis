{
  "protocol": "lachesis-m9b13c-git-object-closure/1",
  "objectDigest": "SHA-1 over type-space-decimal-byte-length-NUL-object-bytes",
  "endpointTemplates": {
    "commit": "https://api.github.com/repos/{owner}/{repository}/git/commits/{40-lowercase-hex-object-id}",
    "tree": "https://api.github.com/repos/{owner}/{repository}/git/trees/{40-lowercase-hex-object-id}",
    "blob": "https://api.github.com/repos/{owner}/{repository}/git/blobs/{40-lowercase-hex-object-id}"
  },
  "roots": [
